{
  "name": "personal-finance-etl",
  "description": "Local-first personal financial systems platform for investment accounting, reconciliation, tax evidence, wealth analytics, FIRE planning, and BI.",
  "version": "9.4.0",
  "repository": "https://github.com/tks18/personal-finance-etl",
  "author": "tks18 <tksudharshan@gmail.com>",
  "license": "GPL-3.0-or-later",
  "packageManager": "yarn@4.12.0",
  "homepage": "https://github.com/tks18/personal-finance-etl",
  "bugs": {
    "url": "https://github.com/tks18/personal-finance-etl/issues"
  },
  "keywords": [
    "personal-finance",
    "data-engineering",
    "financial-analytics",
    "quantitative-finance",
    "duckdb",
    "polars",
    "fire"
  ],
  "scripts": {
    "git:stage": "git add",
    "git:commit": "cz",
    "git:push": "git push --follow-tags origin dev",
    "release": "standard-version --commit-all",
    "release:pre": "standard-version --commit-all --prerelease",
    "release:patch": "standard-version --commit-all --release-as patch",
    "release:minor": "standard-version --commit-all --release-as minor",
    "release:major": "standard-version --commit-all --release-as major",
    "release:as": "standard-version --commit-all --release-as",
    "gh:release:preview": "uv run poe release:preview",
    "gh:release:preview:all": "uv run poe release:preview:all",
    "gh:release:dry-run": "uv run poe release:dry-run",
    "gh:release:latest": "uv run poe release:latest",
    "gh:release:latest:draft": "uv run poe release:latest:draft",
    "gh:release:all": "uv run poe release:all",
    "gh:release:all:draft": "uv run poe release:all:draft",
    "gh:pr:preview": "uv run poe pr:preview",
    "gh:pr:create": "uv run poe pr:create",
    "release:pipeline": "uv run poe release:pipeline",
    "release:flow": "standard-version --commit-all && uv run poe release:pipeline",
    "release:flow:patch": "standard-version --commit-all --release-as patch && uv run poe release:pipeline",
    "release:flow:minor": "standard-version --commit-all --release-as minor && uv run poe release:pipeline",
    "release:flow:major": "standard-version --commit-all --release-as major && uv run poe release:pipeline",
    "pypi:publish": "uv run poe pypi:publish",
    "dev": "uv run poe dev",
    "build": "uv run poe build",
    "lint": "uv run ruff check",
    "lint:fix": "uv run ruff check --fix",
    "check": "uv run poe audit",
    "check:fast": "uv run poe audit-fast",
    "check:csv": "uv run poe audit-csv",
    "audit": "uv run poe audit",
    "audit:fast": "uv run poe audit-fast",
    "audit:fix": "uv run poe audit-fast:fix",
    "audit:full": "uv run poe audit-full",
    "audit:csv": "uv run poe audit-csv",
    "audit:json": "uv run poe audit-json",
    "typecheck": "uv run mypy && uv run pyright",
    "install-hooks": "uv run poe install-hooks",
    "prepare": "uv run poe install-hooks",
    "commit:auto": "uv run poe commit",
    "commit:preview": "uv run poe commit:preview",
    "commit:run": "uv run poe commit:run",
    "commit:interactive": "uv run poe commit:interactive",
    "commit:i": "uv run poe commit:interactive",
    "commit:overrides": "uv run poe commit:overrides",
    "commit:overrides:preview": "uv run poe commit:overrides:preview",
    "commit:overrides:only": "uv run poe commit:overrides:only"
  }
}
