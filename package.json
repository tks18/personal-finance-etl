{
  "name": "personal-finance-etl",
  "description": "Local-first personal financial systems platform for investment accounting, reconciliation, tax evidence, wealth analytics, FIRE planning, and BI.",
  "version": "10.3.1",
  "repository": "https://github.com/tks18/personal-finance-etl",
  "author": "tks18 <tksudharshan@gmail.com>",
  "license": "GPL-3.0-or-later",
  "packageManager": "yarn@4.12.0",
  "homepage": "https://github.com/tks18/personal-finance-etl",
  "bugs": {
    "url": "https://github.com/tks18/personal-finance-etl/issues"
  },
  "keywords": [
    "personal-finance",
    "data-engineering",
    "financial-analytics",
    "quantitative-finance",
    "duckdb",
    "polars",
    "fire"
  ],
  "scripts": {
    "git:stage": "git add",
    "git:commit": "cz",
    "git:push": "git push --follow-tags origin dev",
    "release": "uv run poe release",
    "release:as": "uv run poe release:bump --as",
    "release:bump": "uv run poe release:bump",
    "release:patch": "uv run poe release:patch",
    "release:minor": "uv run poe release:minor",
    "release:major": "uv run poe release:major",
    "release:final": "uv run poe release:final",
    "release:rc": "uv run poe release:rc",
    "release:alpha": "uv run poe release:alpha",
    "release:beta": "uv run poe release:beta",
    "release:major:rc": "uv run poe release:major:rc",
    "release:major:alpha": "uv run python scripts/release_bump.py --major --alpha",
    "release:major:beta": "uv run python scripts/release_bump.py --major --beta",
    "release:minor:rc": "uv run poe release:minor:rc",
    "release:minor:alpha": "uv run python scripts/release_bump.py --minor --alpha",
    "release:minor:beta": "uv run python scripts/release_bump.py --minor --beta",
    "release:patch:rc": "uv run poe release:patch:rc",
    "release:patch:alpha": "uv run python scripts/release_bump.py --patch --alpha",
    "release:patch:beta": "uv run python scripts/release_bump.py --patch --beta",
    "gh:release:preview": "uv run poe release:preview",
    "gh:release:preview:all": "uv run poe release:preview:all",
    "gh:release:dry-run": "uv run poe release:dry-run",
    "gh:release:latest": "uv run poe release:latest",
    "gh:release:latest:draft": "uv run poe release:latest:draft",
    "gh:release:all": "uv run poe release:all",
    "gh:release:all:draft": "uv run poe release:all:draft",
    "gh:pr:preview": "uv run poe pr:preview",
    "gh:pr:create": "uv run poe pr:create",
    "release:pipeline": "uv run poe release:pipeline",
    "release:flow": "uv run poe release:flow",
    "release:flow:bump": "uv run poe release:flow:bump",
    "release:flow:patch": "uv run poe release:flow:patch",
    "release:flow:minor": "uv run poe release:flow:minor",
    "release:flow:major": "uv run poe release:flow:major",
    "release:flow:rc": "uv run poe release:flow:rc",
    "release:flow:alpha": "uv run poe release:flow:alpha",
    "release:flow:beta": "uv run poe release:flow:beta",
    "release:flow:major:rc": "uv run poe release:flow:major:rc",
    "release:flow:minor:rc": "uv run poe release:flow:minor:rc",
    "release:flow:patch:rc": "uv run poe release:flow:patch:rc",
    "release:flow:final": "uv run poe release:flow:final",
    "pypi:publish": "uv run poe pypi:publish",
    "dev": "uv run poe dev",
    "build": "uv run poe build",
    "lint": "uv run ruff check",
    "lint:fix": "uv run ruff check --fix",
    "audit": "uv run poe audit",
    "audit:fast": "uv run poe audit:fast",
    "audit:fix": "uv run poe audit:fix",
    "audit:full": "uv run poe audit:full",
    "audit:csv": "uv run poe audit:csv",
    "audit:json": "uv run poe audit:json",
    "audit:docs": "uv run poe audit:docs",
    "typecheck": "uv run mypy && uv run pyright",
    "install-hooks": "uv run poe install-hooks",
    "prepare": "uv run poe install-hooks",
    "commit:auto": "uv run poe commit",
    "commit:preview": "uv run poe commit:preview",
    "commit:run": "uv run poe commit:run",
    "commit:interactive": "uv run poe commit:interactive",
    "commit:i": "uv run poe commit:interactive",
    "commit:overrides": "uv run poe commit:overrides",
    "commit:overrides:preview": "uv run poe commit:overrides:preview",
    "commit:overrides:only": "uv run poe commit:overrides:only"
  }
}
