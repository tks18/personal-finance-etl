{
  "name": "personal-finance-etl",
  "description": "Local-first financial data engineering and quantitative decision-support platform for reconciled personal finance, investment analytics, tax evidence, FIRE simulation, and BI.",
  "version": "8.1.1",
  "repository": "https://github.com/tks18/personal-finance-etl",
  "author": "tks18 <tksudharshan@gmail.com>",
  "license": "GPL-3.0-or-later",
  "packageManager": "yarn@4.12.0",
  "homepage": "https://github.com/tks18/personal-finance-etl",
  "bugs": {
    "url": "https://github.com/tks18/personal-finance-etl/issues"
  },
  "keywords": [
    "personal-finance",
    "data-engineering",
    "financial-analytics",
    "quantitative-finance",
    "duckdb",
    "polars",
    "fire"
  ],
  "scripts": {
    "git:stage": "git add",
    "git:commit": "cz",
    "git:push": "git push --follow-tags origin master",
    "release": "standard-version --commit-all",
    "release:pre": "standard-version --commit-all --prerelease",
    "release:patch": "standard-version --commit-all --release-as patch",
    "release:minor": "standard-version --commit-all --release-as minor",
    "release:major": "standard-version --commit-all --release-as major",
    "release:as": "standard-version --commit-all --release-as",
    "dev": "uv run poe dev",
    "build": "uv run poe build",
    "lint": "uv run ruff check",
    "lint:fix": "uv run ruff check --fix"
  }
}
